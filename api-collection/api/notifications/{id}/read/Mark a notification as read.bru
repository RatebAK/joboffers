          "related_entity_type": "Application",
          "created_at": "2024-01-15T10:00:00Z"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/notifications/:id/read
    method: POST
