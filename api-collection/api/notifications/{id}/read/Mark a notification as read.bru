meta {
  name: Mark a notification as read
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/notifications/:id/read
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/notifications/:id/read
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
