meta {
  name: Refresh token
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/auth/refresh
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/auth/refresh
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "access_token": "eyJ...",
          "token_type": "bearer",
          "expires_in": 3600,
          "user": {
            "id": "664f1a2b3c4d5e6f7a8b9c0d",
            "name": "Jane Smith",
            "email": "jane@example.com"
          }
        }
      '''
    }
  }
}
