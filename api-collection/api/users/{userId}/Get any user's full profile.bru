meta {
  name: Get any user's full profile
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/users/:userId
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/users/:userId
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "user": {
            "id": "664f1a2b3c4d5e6f7a8b9c0e",
            "name": "Jane Smith",
            "email": "jane@example.com",
            "roles": [
              "employee"
            ],
            "profile": {}
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/users/:userId
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "User not found"
        }
      '''
    }
  }
}
