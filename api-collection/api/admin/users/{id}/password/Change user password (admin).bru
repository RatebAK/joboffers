meta {
  name: Change user password (admin)
  type: http-request
  seq: 1
}

http {
  method: PUT
  url: {{baseUrl}}/api/admin/users/:id/password
  body: json
  auth: inherit
}

body:json {
  {
    "password": "",
    "password_confirmation": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/admin/users/:id/password
    method: PUT
    mode: json
    body:json: {
      {
        "password": "",
        "password_confirmation": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Password updated successfully."
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/admin/users/:id/password
    method: PUT
    mode: json
    body:json: {
      {
        "password": "",
        "password_confirmation": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "User not found."
        }
      '''
    }
  }
}

example {
  name: 422 Response
  
  request: {
    url: {{baseUrl}}/api/admin/users/:id/password
    method: PUT
    mode: json
    body:json: {
      {
        "password": "",
        "password_confirmation": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "password": [
            "The password confirmation does not match."
          ]
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/admin/users/:id/password
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "password": "NewPass@456",
        "password_confirmation": "NewPass@456"
      }
    }
  }
}
