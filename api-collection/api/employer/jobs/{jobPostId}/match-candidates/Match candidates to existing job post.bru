meta {
  name: Match candidates to existing job post
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/employer/jobs/:jobPostId/match-candidates
  body: json
  auth: inherit
}

body:json {
  {
    "limit": 0
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobPostId/match-candidates
    method: POST
    mode: json
    body:json: {
      {
        "limit": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "job_post": {
            "id": "664f1a2b3c4d5e6f7a8b9c0d",
            "title": "Senior React Developer"
          },
          "extracted_requirements": [
            "React",
            "Senior level"
          ],
          "candidates": []
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobPostId/match-candidates
    method: POST
    mode: json
    body:json: {
      {
        "limit": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "You do not own this job post"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobPostId/match-candidates
    method: POST
    mode: json
    body:json: {
      {
        "limit": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Job post not found"
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobPostId/match-candidates
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "limit": 10
      }
    }
  }
}
