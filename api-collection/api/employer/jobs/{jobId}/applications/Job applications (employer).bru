meta {
  name: Job applications (employer)
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/employer/jobs/:jobId/applications
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobId/applications
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "applications": {
            "data": [
              {
                "id": "664f1a2b3c4d5e6f7a8b9c0f",
                "user_id": "664f1a2b3c4d5e6f7a8b9c0e",
                "status": "pending",
                "cover_letter": "I am very interested...",
                "applied_at": "2024-01-15T00:00:00Z",
                "applicant_name": "Jane Smith",
                "ats_score": 82
              }
            ],
            "current_page": 1,
            "per_page": 15,
            "total": 1,
            "total_pages": 1,
            "next_page": null,
            "prev_page": null
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobId/applications
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Forbidden"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/employer/jobs/:jobId/applications
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Job post not found"
        }
      '''
    }
  }
}
