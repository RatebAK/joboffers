meta {
  name: Upload company logo
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/employer/company/logo
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  logo: 
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/employer/company/logo
    method: POST
    mode: multipartForm
    body:multipart-form: {
      logo: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "logo": "https://res.cloudinary.com/dd8vgoh/image/upload/company-logos/abc123.jpg"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/employer/company/logo
    method: POST
    mode: multipartForm
    body:multipart-form: {
      logo: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "No company profile found. Create one first."
        }
      '''
    }
  }
}

example {
  name: 422 Response
  
  request: {
    url: {{baseUrl}}/api/employer/company/logo
    method: POST
    mode: multipartForm
    body:multipart-form: {
      logo: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "logo": [
            "The logo field is required."
          ]
        }
      '''
    }
  }
}
