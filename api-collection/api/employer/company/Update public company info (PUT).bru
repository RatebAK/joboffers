meta {
  name: Update public company info (PUT)
  type: http-request
  seq: 3
}

http {
  method: PUT
  url: {{baseUrl}}/api/employer/company
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "description": "",
    "industry": "",
    "company_size": "",
    "city": "",
    "country": "",
    "phone_main": "",
    "phone_extra": "",
    "phone_visible": false,
    "email": ""
  }
}

example {
  name: 422 Response
  
  request: {
    url: {{baseUrl}}/api/employer/company
    method: PUT
    mode: json
