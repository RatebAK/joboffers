}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/employer/company
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Tammam company",
        "description": "We build software.",
        "industry": "Information Technology Services",
        "company_size": "less_than_10",
        "city": "Damascus",
        "country": "Syria",
        "phone_main": "0932444357",
        "phone_extra": "0911000000",
        "phone_visible": false,
        "email": "contact@tammam.co"
      }
    }
  }
}
