      {
        "name": "",
        "description": "",
        "industry": "",
        "company_size": "",
        "city": "",
        "country": "",
        "phone_main": "",
        "phone_extra": "",
        "phone_visible": false,
        "email": ""
      }
    }
  }
  
  response: {
