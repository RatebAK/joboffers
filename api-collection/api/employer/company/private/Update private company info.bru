example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/employer/company/private
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "expose_to_applicants": false,
        "address": "Mazzeh, Damascus",
        "industry_tags": [
          "Software Development",
          "IT Consulting"
        ],
        "founded_year": 2018,
        "website": "https://tammam.co",
        "social_media": []
      }
    }
  }
}
