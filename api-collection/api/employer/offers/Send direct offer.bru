meta {
  name: Send direct offer
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/employer/offers
  body: json
  auth: inherit
}

body:json {
  {
    "job_seeker_id": "",
    "job_post_id": "",
    "message": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/employer/offers
    method: POST
    mode: json
    body:json: {
      {
        "job_seeker_id": "",
        "job_post_id": "",
        "message": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Direct offer sent successfully",
          "offer": {
            "id": "664f1a2b3c4d5e6f7a8b9c0f",
            "employer_id": "664f1a2b3c4d5e6f7a8b9c0a",
            "job_seeker_id": "664f1a2b3c4d5e6f7a8b9c0e",
            "job_post_id": "664f1a2b3c4d5e6f7a8b9c0d",
            "message": "We think you'd be a great fit.",
            "status": "pending"
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/employer/offers
    method: POST
    mode: json
    body:json: {
      {
        "job_seeker_id": "",
        "job_post_id": "",
        "message": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Forbidden"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/employer/offers
    method: POST
    mode: json
    body:json: {
      {
        "job_seeker_id": "",
        "job_post_id": "",
        "message": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Job post not found"
        }
      '''
    }
  }
}

example {
  name: 409 Response
  
  request: {
    url: {{baseUrl}}/api/employer/offers
    method: POST
    mode: json
    body:json: {
      {
        "job_seeker_id": "",
        "job_post_id": "",
        "message": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "A direct offer has already been sent to this job seeker for this job post"
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/employer/offers
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "job_seeker_id": "664f1a2b3c4d5e6f7a8b9c0e",
        "job_post_id": "664f1a2b3c4d5e6f7a8b9c0d",
        "message": "We think you'd be a great fit for this role."
      }
    }
  }
}
