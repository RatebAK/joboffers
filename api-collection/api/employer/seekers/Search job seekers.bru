meta {
  name: Search job seekers
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/employer/seekers
  body: none
  auth: inherit
}

params:query {
  ~skills: 
  ~min_ats_score: 
  ~max_ats_score: 
  ~location: 
  ~keyword: 
  ~page: 
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/employer/seekers
    method: GET
    mode: none
    params:query: {
      ~skills: 
      ~min_ats_score: 
      ~max_ats_score: 
      ~location: 
      ~keyword: 
      ~page: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "seekers": {
            "data": [
              {
                "id": "664f1a2b3c4d5e6f7a8b9c0d",
                "user_id": "664f1a2b3c4d5e6f7a8b9c0e",
                "current_job_title": "Frontend Developer",
                "ats_score": 82,
                "ai_skills": [
                  "React",
                  "TypeScript"
                ],
                "ai_location": "Beirut, Lebanon",
                "is_actively_seeking": true
              }
            ],
            "current_page": 1,
            "per_page": 10,
            "total": 1,
            "total_pages": 1,
            "next_page": null,
            "prev_page": null
          }
        }
      '''
    }
  }
}
