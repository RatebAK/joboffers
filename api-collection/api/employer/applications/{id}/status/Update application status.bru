meta {
  name: Update application status
  type: http-request
  seq: 1
}

http {
  method: PUT
  url: {{baseUrl}}/api/employer/applications/:id/status
  body: json
  auth: inherit
}

body:json {
  {
    "status": "",
    "feedback": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/employer/applications/:id/status
    method: PUT
    mode: json
    body:json: {
      {
        "status": "",
        "feedback": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Application status updated successfully",
          "application": {
            "id": "664f1a2b3c4d5e6f7a8b9c0f",
            "status": "accepted",
            "feedback": "Great profile."
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/employer/applications/:id/status
    method: PUT
    mode: json
    body:json: {
      {
        "status": "",
        "feedback": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Forbidden"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/employer/applications/:id/status
    method: PUT
    mode: json
    body:json: {
      {
        "status": "",
        "feedback": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Application not found"
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/employer/applications/:id/status
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "status": "accepted",
        "feedback": "Great profile, moving forward."
      }
    }
  }
}
