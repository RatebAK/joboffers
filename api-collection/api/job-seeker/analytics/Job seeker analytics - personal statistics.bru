meta {
  name: Job seeker analytics - personal statistics
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/job-seeker/analytics
  body: none
  auth: inherit
}

example {
  name: 401 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/analytics
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "error": "Unauthorized",
          "message": "Invalid authentication token signature"
        }
      '''
    }
  }
}
