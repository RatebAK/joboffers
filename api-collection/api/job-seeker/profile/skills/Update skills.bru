meta {
  name: Update skills
  type: http-request
  seq: 1
}

http {
  method: PUT
  url: {{baseUrl}}/api/job-seeker/profile/skills
  body: json
  auth: inherit
}

body:json {
  {
    "skills": [
      {
        "name": "",
        "level": ""
      }
    ]
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/profile/skills
    method: PUT
    mode: json
    body:json: {
      {
        "skills": [
          {
            "name": "",
            "level": ""
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Skills updated successfully",
          "profile": {
            "skills": [
              {
                "name": "React",
                "level": "advanced"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/job-seeker/profile/skills
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "skills": [
          []
        ]
      }
    }
  }
}
