meta {
  name: Update social links
  type: http-request
  seq: 1
}

http {
  method: PUT
  url: {{baseUrl}}/api/job-seeker/profile/social-links
  body: json
  auth: inherit
}

body:json {
  {
    "social_links": {
      "linkedin": "",
      "github": "",
      "portfolio": "",
      "twitter": ""
    }
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/profile/social-links
    method: PUT
    mode: json
    body:json: {
      {
        "social_links": {
          "linkedin": "",
          "github": "",
          "portfolio": "",
          "twitter": ""
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Social links updated successfully",
          "profile": {
            "social_links": {
              "linkedin": "https://linkedin.com/in/janesmith"
            }
          }
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/job-seeker/profile/social-links
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "social_links": []
      }
    }
  }
}
