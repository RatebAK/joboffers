example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/job-seeker/profile/career-info
    method: PUT
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "salary_range_from": 2000,
        "salary_range_to": 5000,
        "current_job_status": "architecto",
        "years_of_experience": 5,
        "education_level": "Bachelor's Degree",
        "job_level": "architecto",
        "job_types": [
          "full_time",
          "remote"
        ],
        "job_roles": [
          "Frontend",
          "React"
        ],
        "work_cities": [
          "Beirut",
          "Dubai"
        ],
        "current_job_title": "Frontend Developer",
        "experience_summary": "architecto",
        "expected_salary": 3500,
        "is_actively_seeking": true
      }
    }
  }
}
