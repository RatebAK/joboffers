meta {
  name: Update career information
  type: http-request
  seq: 1
}

http {
  method: PUT
  url: {{baseUrl}}/api/job-seeker/profile/career-info
  body: json
  auth: inherit
}

body:json {
  {
    "salary_range_from": "",
    "salary_range_to": "",
    "current_job_status": "",
    "years_of_experience": 0,
    "education_level": "",
    "job_level": "",
    "job_types": [],
    "job_roles": [],
    "work_cities": [],
    "current_job_title": "",
    "experience_summary": "",
    "expected_salary": "",
    "is_actively_seeking": false
  }
}

example {
  name: 200 Response
  
