meta {
  name: Withdraw application
  type: http-request
  seq: 1
}

http {
  method: DELETE
  url: {{baseUrl}}/api/job-seeker/applications/:id/withdraw
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/applications/:id/withdraw
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Application withdrawn successfully"
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/applications/:id/withdraw
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Cannot withdraw an accepted application"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/applications/:id/withdraw
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Application not found"
        }
      '''
    }
  }
}
