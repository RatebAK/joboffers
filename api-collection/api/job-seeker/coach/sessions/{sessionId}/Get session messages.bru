meta {
  name: Get session messages
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/job-seeker/coach/sessions/:sessionId
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/coach/sessions/:sessionId
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": [
            {
              "role": "user",
              "content": "Hello",
              "created_at": "..."
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/coach/sessions/:sessionId
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Session not found"
        }
      '''
    }
  }
}
