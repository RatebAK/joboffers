meta {
  name: Delete a coach session
  type: http-request
  seq: 2
}

http {
  method: DELETE
  url: {{baseUrl}}/api/job-seeker/coach/sessions/:sessionId
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/coach/sessions/:sessionId
    method: DELETE
    mode: none
  }
  
  response: {
    headers: {
