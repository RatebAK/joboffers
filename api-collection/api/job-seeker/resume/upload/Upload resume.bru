meta {
  name: Upload resume
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/job-seeker/resume/upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  resume: @file(C:\Users\rog\Downloads\Amer-Mahfudh_Up_6a7376ac71320.pdf) @contentType(application/pdf)
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8000
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/resume/upload
    method: POST
    mode: multipartForm
    body:multipart-form: {
      resume: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Resume uploaded successfully. Analysis is being processed.",
          "resume_url": "https://res.cloudinary.com/.../resume.pdf",
          "analysis_status": "pending",
          "profile": {
            "id": "664f1a2b3c4d5e6f7a8b9c0d",
            "ats_score": null,
            "ai_skills": [],
            "ai_analyzed_at": null,
            "analysis_status": "pending"
          }
        }
      '''
    }
  }
}

example {
  name: 502 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/resume/upload
    method: POST
    mode: multipartForm
    body:multipart-form: {
      resume: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 502
      text: Bad Gateway
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Resume analysis service unavailable"
        }
      '''
    }
  }
}
