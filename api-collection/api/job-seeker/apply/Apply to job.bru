meta {
  name: Apply to job
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/job-seeker/apply
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  job_post_id: 
  cover_letter: 
  resume: 
  education: 
  last_work: 
  years_of_experience: 
  why_join: 
  what_to_add: 
  positions_suited_for: 
  notice_period: 
  expected_salary: 
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/apply
    method: POST
    mode: multipartForm
    body:multipart-form: {
      job_post_id: 
      cover_letter: 
      resume: 
      education: 
      last_work: 
      years_of_experience: 
      why_join: 
      what_to_add: 
      positions_suited_for: 
      notice_period: 
      expected_salary: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Application submitted successfully",
          "application": {
            "id": "664f1a2b3c4d5e6f7a8b9c0f",
            "job_post_id": "664f1a2b3c4d5e6f7a8b9c0d",
            "status": "pending",
            "applied_at": "2024-01-15T00:00:00Z",
            "resume": "https://res.cloudinary.com/.../cv.pdf"
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/apply
    method: POST
    mode: multipartForm
    body:multipart-form: {
      job_post_id: 
      cover_letter: 
      resume: 
      education: 
      last_work: 
      years_of_experience: 
      why_join: 
      what_to_add: 
      positions_suited_for: 
      notice_period: 
      expected_salary: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Job post not found or is not active"
        }
      '''
    }
  }
}

example {
  name: 409 Response
  
  request: {
    url: {{baseUrl}}/api/job-seeker/apply
    method: POST
    mode: multipartForm
    body:multipart-form: {
      job_post_id: 
      cover_letter: 
      resume: 
      education: 
      last_work: 
      years_of_experience: 
      why_join: 
      what_to_add: 
      positions_suited_for: 
      notice_period: 
      expected_salary: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "You have already applied to this job"
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/job-seeker/apply
    method: POST
    mode: multipartForm
