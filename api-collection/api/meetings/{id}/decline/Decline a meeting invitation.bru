meta {
  name: Decline a meeting invitation
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/meetings/:id/decline
  body: json
  auth: inherit
}

body:json {
  {
    "decline_reason": ""
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/decline
    method: POST
    mode: json
    body:json: {
      {
        "decline_reason": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meeting": {
            "_id": "664f...",
            "status": "declined",
            "decline_reason": "Schedule conflict"
          }
        }
      '''
    }
  }
}

