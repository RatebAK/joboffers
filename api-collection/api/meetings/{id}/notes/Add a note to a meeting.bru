meta {
  name: Add a note to a meeting
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/meetings/:id/notes
  body: json
  auth: inherit
}

body:json {
  {
    "content": ""
  }
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/notes
    method: POST
    mode: json
    body:json: {
      {
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "meeting": {
            "notes": [
              {
                "author_id": "...",
                "content": "...",
                "created_at": "..."
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 403 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/notes
    method: POST
    mode: json
    body:json: {
      {
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Forbidden"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/notes
    method: POST
    mode: json
    body:json: {
      {
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Meeting not found"
        }
      '''
    }
  }
}

example {
  name: 422 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/notes
    method: POST
    mode: json
    body:json: {
      {
        "content": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "errors": {
            "content": [
              "The content field is required."
            ]
          }
        }
      '''
    }
  }
}

example {
  name: Request Example
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/notes
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        "content": "Please bring your portfolio."
      }
    }
  }
}
