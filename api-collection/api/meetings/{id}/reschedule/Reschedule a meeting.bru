meta {
  name: Reschedule a meeting
  type: http-request
  seq: 1
}

http {
  method: POST
  url: {{baseUrl}}/api/meetings/:id/reschedule
  body: json
  auth: inherit
}

body:json {
  {
    "proposed_date": "",
    "proposed_start_time": "",
    "proposed_duration_minutes": 0
  }
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/reschedule
    method: POST
    mode: json
    body:json: {
      {
        "proposed_date": "",
        "proposed_start_time": "",
        "proposed_duration_minutes": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meeting": {
            "_id": "664f...",
            "status": "rescheduled",
            "proposed_date": "2025-02-20",
            "previous_schedules": [
              {
                "proposed_date": "2025-02-15",
                "proposed_start_time": "14:00",
                "proposed_duration_minutes": 60
              }
            ]
          },
          "organizer_conflicts": [],
          "invitee_conflicts": []
        }
      '''
    }
  }
}

