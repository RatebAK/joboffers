example {
  name: 422 Response
  
  request: {
    url: {{baseUrl}}/api/meetings/:id/reschedule
    method: POST
    mode: json
    body:json: {
      {
        "proposed_date": "",
        "proposed_start_time": "",
        "proposed_duration_minutes": 0
      }
    }
  }
  
