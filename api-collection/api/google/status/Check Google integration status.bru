meta {
  name: Check Google integration status
  type: http-request
  seq: 1
}

http {
  method: GET
  url: {{baseUrl}}/api/google/status
  body: none
  auth: inherit
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/google/status
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "connected": true
        }
      '''
    }
  }
}
