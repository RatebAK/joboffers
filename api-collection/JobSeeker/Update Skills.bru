meta {
  name: Update Skills
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/job-seeker/profile/skills
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "skills": [
      {
        "name": "React",
        "level": "advanced"
      },
      {
        "name": "TypeScript",
        "level": "intermediate"
      },
      {
        "name": "Node.js",
        "level": "intermediate"
      }
    ]
  }
}

docs {
  Replaces all skills with the provided array.
  
  Each skill must have a name. Level is optional.
  
  Level options: beginner, intermediate, advanced, expert
}
