meta {
  name: Update Personal Info
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/job-seeker/profile/personal-info
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "first_name": "Jane",
    "last_name": "Smith",
    "full_name": "Jane Smith",
    "image": "https://example.com/photo.jpg",
    "gender": "female",
    "nationality": "Lebanese",
    "city": "Beirut",
    "location": "Beirut, Lebanon",
    "address": "Main Street 123",
    "phone": "+961 70 123456",
    "date_of_birth": "1995-06-15",
    "marital_status": "single"
  }
}

docs {
  Updates the authenticated job seeker's personal information fields only.
  
  All fields are optional. Only provided fields will be updated.
  
  Gender options: male, female, other, prefer_not_to_say
  Marital status options: single, married, divorced, widowed, prefer_not_to_say
}
