meta {
  name: Apply to Job
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/job-seeker/apply
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "job_post_id": "{{job_id}}",
    "cover_letter": "I am very interested in this position."
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("application_id", res.body.id);
  }
}
