meta {
  name: Update Work Experience
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/job-seeker/profile/work-experience
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "work_experience": [
      {
        "job_title": "Senior Frontend Developer",
        "company_name": "Tech Company Inc",
        "job_roles": ["React", "TypeScript", "Leadership"],
        "from_date": "2021-03",
        "to_date": "2024-01",
        "is_currently_working": false,
        "description": "Led a team of 5 developers building modern web applications using React and TypeScript."
      },
      {
        "job_title": "Frontend Developer",
        "company_name": "Startup Co",
        "job_roles": ["React", "JavaScript"],
        "from_date": "2019-07",
        "to_date": "2021-02",
        "is_currently_working": false,
        "description": "Developed responsive web applications using React."
      }
    ]
  }
}

docs {
  Replaces all work experience entries with the provided array.
  
  All fields are optional within each entry.
}
