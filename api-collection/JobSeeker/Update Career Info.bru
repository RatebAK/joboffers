meta {
  name: Update Career Info
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/job-seeker/profile/career-info
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "salary_range_from": 2000,
    "salary_range_to": 5000,
    "current_job_status": "employed",
    "years_of_experience": 5,
    "education_level": "Bachelor's Degree",
    "job_level": "mid",
    "job_types": ["full_time", "remote"],
    "job_roles": ["Frontend", "React"],
    "work_cities": ["Beirut", "Dubai"],
    "current_job_title": "Frontend Developer",
    "experience_summary": "Experienced developer with focus on React and TypeScript",
    "expected_salary": 3500,
    "is_actively_seeking": true
  }
}

docs {
  Updates the authenticated job seeker's career-related information.
  
  All fields are optional. Only provided fields will be updated.
  
  Job status options: employed, unemployed, freelancing, student, open_to_work
  Job level options: entry, junior, mid, senior, lead, manager, director, executive
}
