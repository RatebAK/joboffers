meta {
  name: List Employer Applications
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/admin/employers
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setEnvVar("employer_application_id", res.body[0].id);
  }
}
