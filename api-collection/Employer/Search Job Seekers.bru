meta {
  name: Search Job Seekers
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/employer/seekers
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  ~skills: React,TypeScript
  ~min_ats_score: 70
  ~max_ats_score: 100
  ~location: Beirut
  ~keyword: frontend
  ~per_page: 10
  ~page: 1
}
