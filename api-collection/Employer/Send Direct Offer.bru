meta {
  name: Send Direct Offer
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/employer/offers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "job_seeker_id": "{{seeker_id}}",
    "job_post_id": "{{job_id}}",
    "message": "We think you'd be a great fit for this role. We'd love to connect!"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("offer_id", res.body.id);
  }
}
