meta {
  name: Update Job Post
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/employer/jobs/{{job_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Senior Frontend Developer (Updated)",
    "location": "Remote, USA",
    "roles": ["Frontend", "React", "Next.js"]
  }
}
