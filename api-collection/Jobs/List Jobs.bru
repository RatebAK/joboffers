meta {
  name: List Jobs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/jobs
  auth: none
}

params:query {
  ~keyword: Laravel
  ~location: Beirut
  ~job_type: full_time
  ~work_mode: remote
  ~experience_level: senior
  ~category: Engineering
  ~min_salary: 2000
  ~max_salary: 8000
  ~tag: React
  ~per_page: 15
  ~page: 1
}
